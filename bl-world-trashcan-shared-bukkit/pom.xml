<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>pixeltech.bluenine</groupId>
        <artifactId>bl-world-trashcan-parent</artifactId>
        <version>7.0.0</version>
    </parent>
    <artifactId>bl-world-trashcan-shared-bukkit</artifactId>
    <packaging>jar</packaging>
    <dependencies>
        <dependency>
            <groupId>pixeltech.bluenine</groupId>
            <artifactId>world-list-trashcan-api</artifactId>
        </dependency>
        <dependency>
            <groupId>pixeltech.bluenine</groupId>
            <artifactId>bl-world-trashcan-core</artifactId>
        </dependency>
        <dependency>
            <groupId>pixeltech.bluenine</groupId>
            <artifactId>bl-world-trashcan-config</artifactId>
        </dependency>
        <dependency>
            <groupId>pixeltech.bluenine</groupId>
            <artifactId>bl-world-trashcan-storage</artifactId>
        </dependency>
        <dependency>
            <groupId>com.destroystokyo.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>${paper.legacy.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>net.md-5</groupId>
            <artifactId>bungeecord-chat</artifactId>
            <version>1.12-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>me.croabeast</groupId>
            <artifactId>PrismaticAPI</artifactId>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>${java.legacy.version}</source>
                    <target>${java.legacy.version}</target>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
