# 每个世界的实体数量限制。
world-limits:
  # 是否启用世界实体数量限制。
  enabled: false
  # 不受限制的世界名。
  ignored-worlds:
  - testWorld
  # 默认限制列表。
  defaults:
  - max-count: 10
    entity: VILLAGER
  - max-count: 20
    entity: CHICKEN

# 密集实体清理。
gather-limits:
  # 是否启用密集实体清理。
  enabled: false
  # 清理密集实体时是否掉落物品。
  drop-items: true
  # 不受密集实体限制的世界名。
  ignored-worlds:
  - testWorld
  # 默认密集限制列表。
  defaults:
  - max-count: 10
    radius: 15
    entity: VILLAGER
    remove-count: 5
