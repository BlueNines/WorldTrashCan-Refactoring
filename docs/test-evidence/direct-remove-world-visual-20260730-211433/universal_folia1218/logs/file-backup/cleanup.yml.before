# 清理周期，单位秒。
# 默认 360 秒；设为 0 时只允许管理员手动触发清理。
interval-seconds: 7

# 跳过清理的世界名。
# 默认示例为 testWorld；留空请写 []。
ignored-worlds:
- testWorld

# 扫地启动门禁。
# 这些配置只决定“本轮扫地是否启动”，不会改变具体哪些物品或实体会被清理。
guards:
  # 在线玩家低于该值时跳过本轮扫地。
  # 默认 1，表示无人在线时不扫地；设为 0 可允许无人在线时继续自动扫地。
  min-online-players: 1
  # 会被本轮扫地处理的目标实体数量低于该值时跳过本轮扫地。
  # 默认 150，避免实体很少时仍频繁扫描和清理；设为 0 可关闭实体数量门禁。
  min-total-entities: 150

# Folia 专用清理保护。
# 普通 Bukkit、Paper、Legacy 运行时会读取但不会使用这些设置。
folia:
  # 单轮 Folia 清理最多执行多少秒；超时后会释放清理状态，迟到的 region 任务不再计入本轮统计。
  timeout-seconds: 30
  # 单轮最多扫描多少个已加载 chunk；0 表示不限制。大型生存服建议保持默认或更低，避免一次扫完整个加载世界。
  max-chunks-per-cleanup: 4096
  # 每批向 Folia RegionScheduler 派发多少个 chunk 扫描任务；数值越大瞬时压力越高。
  chunk-batch-size: 64
  # 每批 chunk 扫描任务之间间隔多少 tick；最小 1，默认 1 用来削峰。
  chunk-batch-delay-ticks: 1

# 不回收也不删除的物品类型。
# 使用当前版本平台标准化后的 Material 名称。
ignored-materials:
- DIAMOND

# 显示名包含以下片段时跳过清理。
# 可用于保护特殊商店、祭坛、任务物品。
ignored-name-fragments:
- shopLocation
- ALTAR

# lore 包含以下片段时跳过清理。
# 默认保护 QuickShop 一类带位置 lore 的物品。
ignored-lore-fragments:
- shopLocation

# 实体清理规则。
entities:
  # 是否启用实体清理总开关。
  # 默认 true；改为 false 时，经验球、怪物、动物、投射物、实体黑名单等实体清理规则都会整体跳过。
  enabled: true
  # 是否清理经验球。
  clear-experience-orbs: true
  # 是否清理怪物。
  clear-monsters: true
  # 是否清理动物或普通生物。
  clear-animals: true
  # 是否清理投射物。
  clear-projectiles: true
  # 是否清理带自定义名的实体。
  clear-named-entities: false
  # 是否跳过船内实体。
  ignore-entities-in-boat: false
  # 实体白名单；命中后不清理，支持 * 通配。
  whitelist:
  - VILLAGER
  - '*golem*'
  - WITHER
  - Ender Dragon
  # 实体黑名单；命中后强制清理，支持 * 通配。白名单优先级更高。
  blacklist:
  - FLAMMPFEIL.SLASHBLADE_BLADESTAND

# 清理通知配置。
# 这些通知都属于扫地功能的一部分，因此统一放在 cleanup.yml 中维护。
notify:
  # 聊天栏提醒。
  chat:
    # 是否启用聊天提醒。
    enabled: true
    # 清理完成消息点击后执行的命令。
    click-command: /wtc globaltrash
    # 倒计时聊天提醒，格式：剩余秒数;内容。
    messages:
    - 60;&d还剩下 60 秒清理物品和实体
    - 30;&d还剩下 30 秒清理物品和实体
    - 10;&d还剩下 10 秒清理物品和实体
    - 5;&c5秒
    - 3;&c3秒
    - 2;&c2秒
    - 1;&c1秒
    - 0;&a清理成功，有%DealItemSum%个物品被回收，有%GlobalTrashAddSum%个物品加入了公共垃圾桶，有%EntitySum%个生物被清理
      &6(点我打开垃圾桶)
    - -1;&d还有%ClearGlobalCount%次清理，公共垃圾桶
    - -2;&a公共垃圾桶的物品已刷新
  
  # 控制台清理日志；独立于聊天提醒，即使 chat.enabled 为 false 也可以继续记录。
  console:
    # 是否输出倒计时、完成文案和清理明细；旧配置缺少本项时兼容读取 notify.chat.console-log。
    enabled: true
    # 清理成功或 Folia 部分超时时，是否输出按实体名称和类型聚合的详细统计。
    details-enabled: true
    # 最多显示清理数量最高的实体分组数；默认 10，运行时限制范围为 1-100。
    max-entries: 10
    # 实体明细格式；名称优先使用自定义名，其次 getName()，最后使用 getType()。
    # 可用占位符：{name} 实体名称、{type} 小写实体类型、{count} 清理数量。
    entity-format: '{name}_{type}: {count}'
    # 物品汇总格式；数量是本轮成功入桶或直接删除的物品实际个数，不是掉落物堆叠数。
    # 可用占位符：{count} 物品实际数量。
    items-format: 'items: {count}'
    # 实体分组超过 max-entries 时，其余未逐项显示实体的汇总格式。
    # 可用占位符：{count} 未逐项显示的实体总数。
    others-format: 'others: {count}'
  
  # ActionBar 提醒。
  actionbar:
    # 是否启用 ActionBar。
    enabled: true
    # 倒计时 ActionBar 提醒，格式：剩余秒数;内容。
    messages:
    - 60;&d&l还剩下 60 秒清理物品和实体
    - 30;&d&l还剩下 30 秒清理物品和实体
    - 10;&d&l还剩下 10 秒清理物品和实体
    - 5;&c&l5秒
    - 3;&c&l3秒
    - 2;&c&l2秒
    - 1;&c&l1秒
    - 0;&a清理成功，有%GlobalTrashAddSum%个物品加入了公共垃圾桶，有%EntitySum%个生物被清理
    - -1;&d还有%ClearGlobalCount%次清理，公共垃圾桶
    - -2;&a公共垃圾桶的物品已刷新
  
  # BossBar 提醒。
  bossbar:
    # 是否启用 BossBar。
    enabled: false
    # 倒计时 BossBar 提醒，格式：剩余秒数;内容;样式;颜色。
    # 样式可用 SOLID、SEGMENTED_6、SEGMENTED_10、SEGMENTED_12、SEGMENTED_20；颜色可用 PINK、BLUE、RED、GREEN、YELLOW、PURPLE、WHITE。
    # -1 表示本轮清理完成但公共垃圾桶未刷新，-2 表示公共垃圾桶已刷新，-3 表示公共垃圾桶不会自动刷新，-4 表示 Folia 本轮清理超时但已释放状态。
    messages:
    - 30;&d&l即将清理物品和实体;SOLID;RED
    - 29;&d&l即将清理物品和实体;SOLID;YELLOW
    - 28;&d&l即将清理物品和实体;SOLID;GREEN
    - 27;&d&l即将清理物品和实体;SOLID;BLUE
    - 26;&d&l即将清理物品和实体;SOLID;PINK
    - 25;&d&l即将清理物品和实体;SOLID;PURPLE
    - 24;&d&l即将清理物品和实体;SOLID;WHITE
    - 23;&d&l即将清理物品和实体;SEGMENTED_6;RED
    - 22;&d&l即将清理物品和实体;SEGMENTED_6;YELLOW
    - 21;&d&l即将清理物品和实体;SEGMENTED_6;GREEN
    - 20;&d&l即将清理物品和实体;SEGMENTED_6;BLUE
    - 19;&d&l即将清理物品和实体;SEGMENTED_6;PINK
    - 18;&d&l即将清理物品和实体;SEGMENTED_6;PURPLE
    - 17;&d&l即将清理物品和实体;SEGMENTED_6;WHITE
    - 16;&d&l即将清理物品和实体;SEGMENTED_10;RED
    - 15;&d&l即将清理物品和实体;SEGMENTED_10;YELLOW
    - 14;&d&l即将清理物品和实体;SEGMENTED_10;GREEN
    - 13;&d&l即将清理物品和实体;SEGMENTED_10;BLUE
    - 12;&d&l即将清理物品和实体;SEGMENTED_10;PINK
    - 11;&d&l即将清理物品和实体;SEGMENTED_10;PURPLE
    - 10;&d&l即将清理物品和实体;SEGMENTED_10;WHITE
    - 9;&d&l即将清理物品和实体;SEGMENTED_12;RED
    - 8;&d&l即将清理物品和实体;SEGMENTED_12;YELLOW
    - 7;&d&l即将清理物品和实体;SEGMENTED_12;GREEN
    - 6;&d&l即将清理物品和实体;SEGMENTED_12;BLUE
    - 5;&d&l即将清理物品和实体;SEGMENTED_12;PINK
    - 4;&d&l即将清理物品和实体;SEGMENTED_12;PURPLE
    - 3;&d&l即将清理物品和实体;SEGMENTED_20;WHITE
    - 2;&d&l即将清理物品和实体;SEGMENTED_20;RED
    - 1;&d&l即将清理物品和实体;SEGMENTED_20;YELLOW
    - 0;&a清理成功，有%GlobalTrashAddSum%个物品加入了公共垃圾桶，有%EntitySum%个生物被清理;SEGMENTED_20;GREEN
    - -1;&d还有%ClearGlobalCount%次清理，公共垃圾桶;SEGMENTED_20;GREEN
    - -2;&a公共垃圾桶的物品已刷新;SEGMENTED_20;GREEN
  
  # Title 提醒。
  title:
    # 是否启用 Title。
    enabled: false
    # 倒计时 Title 提醒，格式：剩余秒数;主标题;副标题。
    messages:
    - 60;&d还剩下 60 秒;清理物品和实体
    - 30;&d还剩下 30 秒;清理物品和实体
    - 10;&d还剩下 10 秒;清理物品和实体
    - 5;&c5秒
    - 3;&c3秒
    - 2;&c2秒
    - 1;&c1秒
    - 0;&a清理成功;有%GlobalTrashAddSum%个物品加入了公共垃圾桶，有%EntitySum%个生物被清理
    - -1;&d还有%ClearGlobalCount%次清理，公共垃圾桶
    - -2;&a公共垃圾桶的物品已刷新
  
  # 声音提醒。
  sound:
    # 是否启用提示音。
    enabled: true
    # 倒计时声音提醒，格式：剩余秒数;声音名,音量,音调。
    messages:
    - 5;entity.experience_orb.pickup,0.4,0.2
    - 3;entity.experience_orb.pickup,0.4,0.4
    - 2;entity.experience_orb.pickup,0.4,0.6
    - 1;entity.experience_orb.pickup,0.4,0.8
    - 0;entity.experience_orb.pickup,0.4,1
  
  # 控制台命令提醒。
  command:
    # 是否启用倒计时命令。
    enabled: false
    # 倒计时命令，格式：剩余秒数;命令1;命令2。
    commands:
    - 0;mm mobs killall;say 测试用句：&amm怪物已清理成功
