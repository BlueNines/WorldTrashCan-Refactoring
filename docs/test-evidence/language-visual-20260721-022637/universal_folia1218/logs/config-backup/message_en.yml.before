# 插件前缀，会自动替换 {prefix}。
prefix: "&#64748B[&#5AC8FAWorldListTrashCan&#64748B] "

# 通用无权限提示。
no-permission: "{prefix}&#FFD166You do not have permission to use this command."

# 重载成功提示。
reload-success: "{prefix}&#5AC8FAConfiguration reloaded."

# 公共垃圾桶相关消息。
global-trash:
  # 公共垃圾桶未启用时提示。
  disabled: "{prefix}&#FFD166Global trash is disabled."
  # 玩家没有权限从公共垃圾桶取出物品。
  no-take-permission: "{prefix}&#FFD166You do not have permission to take items from global trash."
  # 公共垃圾桶拿取冷却提示，{time} 为剩余秒数。
  take-cooldown: "{prefix}&#FFD166You must wait {time} seconds before taking another item."
  # 公共垃圾桶 GUI 文案。
  gui:
    # GUI 标题，{page} 当前页，{max} 总页数。
    title: "&#0F172AGlobal Trash {page}/{max}"
    # 上一页按钮名称。
    back: "&#5AC8FAPrevious Page"
    # 下一页按钮名称。
    next: "&#5AC8FANext Page"

# 个人垃圾桶相关消息。
personal-trash:
  # 个人垃圾桶未启用时提示。
  disabled: "{prefix}&#FFD166Personal trash is disabled."
  # 玩家没有权限从个人垃圾桶取出物品。
  no-take-permission: "{prefix}&#FFD166You do not have permission to take items from personal trash."
  # 玩家余额不足时提示。
  not-enough-money: "{prefix}&#FFD166You do not have enough money to take this item."
  # 玩家背包空间不足时提示。
  inventory-full: "{prefix}&#FFD166Your inventory does not have enough space to take this item."
  # 玩家成功支付取出费用，{cost} 为扣费显示。
  pay-success: "{prefix}&#5AC8FAPaid {cost}."
  # 个人垃圾桶 GUI 文案。
  gui:
    # GUI 标题，{player} 为玩家名。
    title: "&#0F172A{player}'s Personal Trash"
  # 自动进入个人垃圾桶时的提示文案。
  recycle:
    # 单个来源进入个人垃圾桶时发送，{items} 为格式化后的物品列表。
    single: "{prefix}&#5AC8FARecovered to personal trash: {items}"
    # 批量清理进入个人垃圾桶时发送，{items} 为格式化后的物品列表。
    batch: "{prefix}&#5AC8FACleanup recovered to personal trash: {items}"
    # 物品列表整体格式，{items} 为已经拼接好的物品条目。
    list: "&#64748B[{items}&#64748B]"
    # 多个物品条目之间的分隔符。
    separator: "&#64748B, "
    # 单个物品数量大于 1 时的条目格式，{name} 为物品名，{amount} 为总数量。
    item: "&#C9D4E2{name}&#64748B*&#C9D4E2{amount}"
    # 单个物品数量等于 1 时的条目格式，{name} 为物品名。
    item-single: "&#C9D4E2{name}"
    # 物品条目超过 trash.yml 中 max-display-items 后追加的省略标记。
    ellipsis: "&#64748B..."

# 黑名单 GUI 相关消息。
ban-gui:
  # 世界黑名单 GUI 标题，{world} 为世界名。
  world-title: "&#0F172AWorld Blacklist: {world}"
  # 公共垃圾桶黑名单 GUI 标题。
  global-title: "&#0F172AGlobal Trash Blacklist"
  # 保存世界黑名单时世界不存在。
  world-missing: "{prefix}&#FFD166World not found, cannot save blacklist: {world}"
  # 世界黑名单保存成功，{count} 为物品数量。
  world-save-success: "{prefix}&#5AC8FASaved world trash blacklist, items: &#C9D4E2{count}"
  # 世界黑名单保存失败。
  world-save-fail: "{prefix}&#FFD166Failed to save world trash blacklist. Check server logs."
  # 公共黑名单保存成功，{count} 为物品数量。
  global-save-success: "{prefix}&#5AC8FASaved global trash blacklist, items: &#C9D4E2{count} &#64748B(applied immediately)"
  # 公共黑名单保存失败。
  global-save-fail: "{prefix}&#FFD166Failed to save global trash blacklist. Check server logs."

# 防护和查询相关消息。
protection:
  # 关闭防丢弃模式。
  drop-mode-off: "{prefix}&#5AC8FADrop protection disabled."
  # 开启防丢弃模式。
  drop-mode-on: "{prefix}&#5AC8FADrop protection enabled."
  # 防丢弃模式拦截玩家丢弃。
  drop-blocked: "{prefix}&#FFD166Drop protection blocked this item drop."
  # look 查询等待玩家右键实体。
  look-prompt: "{prefix}&#5AC8FARight-click an entity to inspect its name."
  # look 查询实体结果，{name} 为实体名，{type} 为实体类型。
  entity-result: "{prefix}&#5AC8FAEntity: &#C9D4E2{name} &#64748B({type})"
  # 当前区块实体列表标题。
  chunk-entities-title: "{prefix}&#5AC8FACurrent chunk entities:"
  # 当前区块实体单行，{text} 为实体名和数量。
  chunk-entity-line: "{prefix}&#5AC8FA{text}"
  # 手持物品查询结果，{material} 为物品类型。
  hand-item: "{prefix}&#5AC8FAMain hand item: &#C9D4E2{material}"

# Entity limit messages.
entity-limit:
  # Sent to nearby players after dense entity cleanup. {range} radius, {entity} entity type, {size} nearby count before cleanup, {max} allowed count, {removed} removed count.
  gather-cleared: "{prefix}&#FFD166Dense entity cleanup &#64748B| &#C9D4E2Within &#FFD166{range} &#C9D4E2blocks around you there were &#FFD166{entity} x {size}&#C9D4E2, above limit &#FFD166{max}&#C9D4E2. Removed &#5AC8FA{removed} &#C9D4E2this round."

# 世界垃圾桶相关消息。
world-trash:
  # 当前世界禁止创建世界垃圾桶。
  create-banned-world: "{prefix}&#FFD166World trash cans cannot be created in this world."
  # 告示牌没有连接到可用容器。
  create-not-container: "{prefix}&#FFD166The sign must be attached to, or placed above, a container."
  # 当前世界垃圾桶数量达到上限。
  create-reach-limit: "{prefix}&#FFD166This world has reached the world trash can limit."
  # 创建世界垃圾桶成功，{world} 为世界名。
  create-success: "{prefix}&#5AC8FACreated a world trash can in &#C9D4E2{world}&#5AC8FA."
  # 创建世界垃圾桶保存失败。
  create-save-fail: "{prefix}&#FFD166Failed to save world trash can. Check server logs."
  # 移除世界垃圾桶登记成功。
  remove-success: "{prefix}&#5AC8FARemoved this world trash can registration."
# 主命令相关消息。
command:
  # 通用无权限提示。
  no-permission: "{prefix}&#FFD166You do not have permission to use this command."
  # 重载成功提示。
  reload-success: "{prefix}&#5AC8FAWorldListTrashCan reloaded."
  # 手动清理完成提示，{worlds} 世界数，{routed} 回收物品数，{items} 移除物品数，{entities} 移除实体数。
  clear-success: "{prefix}&#5AC8FACleanup finished: &#C9D4E2worlds {worlds}&#5AC8FA, routed items {routed}&#5AC8FA, removed items {items}&#5AC8FA, removed entities {entities}&#5AC8FA."
  # 手动清理 guards 参数错误时提示。
  clear-guard-usage: "{prefix}&#FFD166Usage: /wtc clear [true/false]. true ignores guards for this run; false obeys guards."
  # Folia 不支持当前清理扫描时提示。
  folia-clear-unsupported: "{prefix}&#FFD166This Folia build has not enabled region-safe cleanup; world entity scan was refused."
  # Folia 上一轮清理仍在运行时提示。
  folia-clear-running: "{prefix}&#FFD166The previous Folia region-safe cleanup is still running; this request was skipped."
  # Folia 清理任务启动成功提示。
  folia-clear-started: "{prefix}&#5AC8FAStarted Folia region-safe cleanup; check [FoliaCleanup] logs or run /wtc stats after it finishes."
  # 没有打开公共垃圾桶权限时提示。
  no-global-open-permission: "{prefix}&#FFD166You do not have permission to open global trash."
  # 没有打开个人垃圾桶权限时提示。
  no-personal-open-permission: "{prefix}&#FFD166You do not have permission to open personal trash."
  # /wtc help 输出，每行一条。主帮助只展示正式命令；调试命令请使用 /wtc debughelp。
  help:
    - "&#5AC8FA/wtc help &#64748B- Show help"
    - "&#5AC8FA/wtc platform &#64748B- Show this build's capabilities"
    - "&#5AC8FA/wtc clear [true/false] &#64748B- Run cleanup; default true ignores guards, false obeys guards"
    - "&#5AC8FA/wtc global &#64748B- Open global trash"
    - "&#5AC8FA/wtc personal &#64748B- Open personal trash"
    - "&#5AC8FA/wtc dropmode &#64748B- Toggle drop protection"
    - "&#5AC8FA/wtc look &#64748B- Inspect held item and right-clicked entity type"
    - "&#5AC8FA/wtc ban &#64748B- Open this world's trash blacklist"
    - "&#5AC8FA/wtc globalban &#64748B- Open the global trash blacklist"
    - "&#5AC8FA/wtc stats &#64748B- Show cleanup and trash statistics"
    - "&#5AC8FA/wtc add <amount> &#64748B- Add world trash slots to your current world"
    - "&#5AC8FA/wtc add <world> <amount> &#64748B- Add world trash slots to a specific world"
    - "&#5AC8FA/wtc debughelp &#64748B- Show debug commands"
    - "&#5AC8FA/wtc reload &#64748B- Reload the plugin"
  # /wtc debughelp 输出，每行一条。调试命令会改变测试服运行态，不作为普通玩家功能展示。
  debug-help:
    - "&#5AC8FA/wtc debugopen <player> <global|personal> &#64748B- Test opening a GUI"
    - "&#5AC8FA/wtc debugworldtrash <player> &#64748B- Create and register a test world trash can"
    - "&#5AC8FA/wtc debugroute <player> <world|personal|global> <Material> <amount> &#64748B- Test a trash route"
    - "&#5AC8FA/wtc debugdrop <player> <Material> <amount> [owner] &#64748B- Spawn a test dropped item"
    - "&#5AC8FA/wtc debugdamage <player> <Material> <amount> &#64748B- Test damage recovery"
    - "&#5AC8FA/wtc debugstock &#64748B- Show backend trash stock"
    - "&#5AC8FA/wtc debugsummary <player> &#64748B- Show backend test summary"
    - "&#5AC8FA/wtc debugdensity &#64748B- Show entity density scanner and candidate queue"
    - "&#5AC8FA/wtc debugnotify <count> &#64748B- Trigger a cleanup.yml notification count through the real notification pipeline"
    - "&#5AC8FA/wtc debugplayer <player> <dropmode|look|ban|globalban> &#64748B- Test player-only entry points"
    - "&#5AC8FA/wtc debugrgb <player> &#64748B- Test RGB/fallback visible channels"
    - "&#5AC8FA/wtc debugrgbchannels <player> &#64748B- Test Chat, ActionBar and Title RGB/fallback channels"
    - "&#64748BThese commands change test-server state; use them only for validation and diagnostics."
  # 平台信息标题，{platform} 为平台 ID。
  platform:
    header: "{prefix}&#5AC8FACurrent platform: &#C9D4E2{platform}"
    # 平台能力已启用文案。
    enabled: "&#5AC8FAEnabled"
    # 平台能力已禁用文案。
    disabled: "&#64748BDisabled"
    # 平台能力单行，{capability} 为能力名，{state} 为启用状态。
    line: "&#64748B- &#C9D4E2{capability}&#64748B: {state}"
  # /wtc stats 输出。
  stats:
    header: "{prefix}&#5AC8FACleanup statistics:"
    worlds: "&#64748B- &#C9D4E2Worlds: &#5AC8FA{worlds}"
    routed: "&#64748B- &#C9D4E2Routed items: &#5AC8FA{routed} &#64748B(world {world}, personal {personal}, global {global})"
    removed-items: "&#64748B- &#C9D4E2Removed items: &#5AC8FA{items}"
    removed-entities: "&#64748B- &#C9D4E2Removed entities: &#5AC8FA{entities}"
    global-pages: "&#64748B- &#C9D4E2Global trash pages: &#5AC8FA{pages}"
    global-items: "&#64748B- &#C9D4E2Global trash items: &#5AC8FA{items} &#64748B(stacks {stacks})"
    personal-loaded: "&#64748B- &#C9D4E2Loaded personal trash: &#5AC8FA{count}"
    remaining: "&#64748B- &#C9D4E2Seconds until next cleanup: &#5AC8FA{seconds}"
  # 找不到世界时提示，{world} 为输入的世界名。
  world-not-found: "{prefix}&#FFD166World not found: &#C9D4E2{world}"
  # 控制台执行 add 未指定世界时提示。
  add-console-world-required: "{prefix}&#FFD166Console must specify a world name when using add."
  # add 数量不是正数时提示。
  add-positive-required: "{prefix}&#FFD166Amount must be greater than 0."
  # add 成功提示，{world} 为世界名，{count} 为调整后的上限。
  add-success: "{prefix}&#5AC8FAWorld &#C9D4E2{world} &#5AC8FAtrash can limit is now &#C9D4E2{count}&#5AC8FA."
  # add 用法提示。
  add-usage:
    - "&#FFD166Usage: /wtc add <amount>"
    - "&#FFD166Usage: /wtc add <world> <amount>"
  # 没有防丢弃模式权限时提示。
  no-dropmode-permission: "{prefix}&#FFD166You do not have permission to use drop protection."
  # 没有 look 查询权限时提示。
  no-look-permission: "{prefix}&#FFD166You do not have permission to use look inspection."
  # 没有世界黑名单权限时提示。
  no-world-ban-permission: "{prefix}&#FFD166You do not have permission to open the world blacklist."
  # 没有公共黑名单权限时提示。
  no-global-ban-permission: "{prefix}&#FFD166You do not have permission to open the global blacklist."
  # 非玩家执行玩家命令时提示。
  only-player: "{prefix}&#FFD166This command can only be used by players."
  # 玩家不在线时提示，{player} 为玩家名。
  player-offline: "{prefix}&#FFD166Player is not online: {player}"
