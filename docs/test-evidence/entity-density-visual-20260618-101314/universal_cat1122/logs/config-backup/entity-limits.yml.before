# 每个世界的实体数量限制。
world-limits:
  enabled: false
  ignored-worlds:
  - testWorld
  defaults:
  - max-count: 10
    entity: VILLAGER
  - max-count: 20
    entity: CHICKEN
gather-limits:
  enabled: false
  drop-items: true
  ignored-worlds:
  - testWorld
  defaults:
  - max-count: 10
    radius: 8
    entity: VILLAGER
    remove-count: 5
