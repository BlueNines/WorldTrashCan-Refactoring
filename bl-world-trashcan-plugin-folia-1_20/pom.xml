<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>pixeltech.bluenine</groupId>
        <artifactId>bl-world-trashcan-parent</artifactId>
        <version>7.0.0</version>
    </parent>
    <artifactId>bl-world-trashcan-plugin-folia-1_20</artifactId>
    <packaging>jar</packaging>
    <dependencies>
        <dependency>
            <groupId>pixeltech.bluenine</groupId>
            <artifactId>bl-world-trashcan-platform-folia-1_20</artifactId>
        </dependency>
        <dependency>
            <groupId>pixeltech.bluenine</groupId>
            <artifactId>bl-world-trashcan-config</artifactId>
        </dependency>
        <dependency>
            <groupId>pixeltech.bluenine</groupId>
            <artifactId>bl-world-trashcan-storage</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.folia</groupId>
            <artifactId>folia-api</artifactId>
            <version>${folia.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>net.milkbowl.vault</groupId>
            <artifactId>VaultAPI</artifactId>
            <version>1.7</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>me.clip</groupId>
            <artifactId>placeholderapi</artifactId>
            <version>2.11.6</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>
    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>${java.modern.version}</source>
                    <target>${java.modern.version}</target>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <artifactSet>
                                <includes>
                                    <include>pixeltech.bluenine:bl-world-trashcan-core</include>
                                    <include>pixeltech.bluenine:bl-world-trashcan-config</include>
                                    <include>pixeltech.bluenine:bl-world-trashcan-storage</include>
                                    <include>pixeltech.bluenine:bl-world-trashcan-shared-bukkit</include>
                                    <include>pixeltech.bluenine:bl-world-trashcan-platform-folia-1_20</include>
                                    <include>me.croabeast:PrismaticAPI</include>
                                </includes>
                            </artifactSet>
                            <relocations>
                                <relocation>
                                    <pattern>me.croabeast</pattern>
                                    <shadedPattern>pixeltech.bluenine.blworldtrashcan.libs.croabeast</shadedPattern>
                                </relocation>
                            </relocations>
                            <filters>
                                <filter>
                                    <artifact>me.croabeast:PrismaticAPI</artifact>
                                    <excludes>
                                        <exclude>plugin.yml</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
